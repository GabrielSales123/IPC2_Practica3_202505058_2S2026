
@{
    ViewData["Title"] = "Sistema de Veterinaria";
    string nombreSistema = "Sistema de Veterinaria";
    int totalMascotas = 0;
}

    <h1>@nombreSistema</h1>

<p>Bienvenido al sistema de administración de mascotas.</p>

<p>Total de mascotas registradas: @totalMascotas</p>

@if (totalMascotas == 0)
{
    <p>No hay mascotas registradas todavía.</p>
}
else
{
    <p>Ya existen mascotas registradas en el sistema.</p>
}
<form>
    <h3>Agregar mascota</h3>
    <label>Seleccione la especie</label>
    <select id="especie" name="especie">
    <option value="" selected disabled>Seleccione una especie</option>
    <option value="Perro">Perro</option>
    <option value="Gato">Gato</option>
    <option value="Tortuga">Tortuga</option>
    <option value="Ave">Ave</option>
    </select>
    <label>Nombre</label>
    <input type="text" id="nombre" name="nombre" placeholder="Ingrese el nombre de la mascota" />
    <label>Peso</label>
    <input type="text" id="peso" name="peso" placeholder="Ingrese el peso de la mascota" />
    <label>Edad</label>
    <input type="text" id="edad" name="edad" placeholder="Ingrese la edad de la mascota"/>
    <label>Sexo</label>
    <input type="text" id="sexo" name="sexo" placeholder="Ingrese el sexo de la mascota"/>
    <label>Propietario</label>
    <input type="text" id="propietario" name="propietario"placeholder="Ingrese el nombre del propietario"/>
    <label>Estado</label>
    <select id="estado" name="estado">
    <option value="" selected disabled>Seleccione el estado de la mascota</option>
    <option value="Enfermo">Enfermo</option>
    <option value="Sano">Sano</option>
    </select>
    <div id="campos-Perro" class="campos-especie" hidden>
    <label>Raza del perro</label>
    <input type="text" name="razaPerro" />

    <label>Tamaño</label>
    <input type="text" name="tamanoPerro" />
</div>

<div id="campos-Gato" class="campos-especie" hidden>
    <label>Raza del gato</label>
    <input type="text" name="razaGato" />

    <label>¿Está esterilizado?</label>
    <select name="esterilizado">
        <option value="true">Sí</option>
        <option value="false">No</option>
    </select>
</div>

<div id="campos-Tortuga" class="campos-especie" hidden>
    <label>Tipo de caparazón</label>
    <input type="text" name="tipoCaparazon" />

    <label>¿Es acuática?</label>
    <select name="esAcuatica">
        <option value="true">Sí</option>
        <option value="false">No</option>
    </select>
</div>

<div id="campos-Ave" class="campos-especie" hidden>
    <label>Envergadura</label>
    <input type="number" name="envergadura" />

    <label>¿Puede volar?</label>
    <select name="volador">
        <option value="true">Sí</option>
        <option value="false">No</option>
    </select>
</div>
    <button type="submit">Agregar</button>
</form>